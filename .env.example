# GEMINI_API_KEY: Required for Gemini AI API calls (Server-side only — DO NOT prefix with VITE_).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# ==============================================================================
# AMBIENTE LOCAL E FIREBASE EMULATOR SUITE (PADRÃO EM DEV E TESTES)
# ==============================================================================
# VITE_APP_ENV: Ambiente da aplicação ('development' | 'production' | 'test').
# Em 'development' e 'test', o sistema utiliza EXCLUSIVAMENTE o projeto local
# 'demo-projeto-beta-v3' conectado aos emuladores locais (127.0.0.1).
VITE_APP_ENV="development"
VITE_USE_FIREBASE_EMULATOR="true"
VITE_FIREBASE_PROJECT_ID="demo-projeto-beta-v3"
VITE_FIREBASE_EMULATOR_HOST="127.0.0.1"
VITE_FIREBASE_AUTH_EMULATOR_PORT="9099"
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT="8080"
VITE_FIREBASE_STORAGE_EMULATOR_PORT="9199"
VITE_FIREBASE_FUNCTIONS_EMULATOR_PORT="5001"
VITE_FIREBASE_UI_EMULATOR_PORT="4000"

# ==============================================================================
# CONFIGURAÇÃO DO FIREBASE PARA PRODUÇÃO (Apenas quando VITE_APP_ENV="production")
# ==============================================================================
# NUNCA coloque chaves privadas administrativas (service account) com prefixo VITE_.
# VITE_FIREBASE_API_KEY="sua_api_key_publica_de_producao"
# VITE_FIREBASE_AUTH_DOMAIN="seu_projeto_prod.firebaseapp.com"
# VITE_FIREBASE_PROJECT_ID="seu_projeto_prod"
# VITE_FIREBASE_STORAGE_BUCKET="seu_projeto_prod.firebasestorage.app"
# VITE_FIREBASE_MESSAGING_SENDER_ID="seu_sender_id"
# VITE_FIREBASE_APP_ID="seu_app_id"
