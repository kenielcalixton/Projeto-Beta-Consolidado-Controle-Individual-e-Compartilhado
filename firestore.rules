rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funções Utilitárias de Governança
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSpaceActive(spaceId) {
      return get(/databases/$(database)/documents/spaces/$(spaceId)).data.spaceStatus == 'active';
    }

    function isSpaceMember(spaceId) {
      return isAuthenticated() && 
        request.auth.uid in get(/databases/$(database)/documents/spaces/$(spaceId)).data.memberUids;
    }

    function isSpaceHistoricalMember(spaceId) {
      return isAuthenticated() && (
        isSpaceMember(spaceId) ||
        (
          'historicalMemberUids' in get(/databases/$(database)/documents/spaces/$(spaceId)).data &&
          request.auth.uid in get(/databases/$(database)/documents/spaces/$(spaceId)).data.historicalMemberUids
        )
      );
    }

    function isSpaceCreator(spaceId) {
      return isAuthenticated() && 
        request.auth.uid == get(/databases/$(database)/documents/spaces/$(spaceId)).data.creatorUid;
    }

    function isAccountOwner(accountId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/accounts/$(accountId)).data.userId == request.auth.uid;
    }

    // 1. Contas Pessoais e Livro de Movimentações
    match /accounts/{accountId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Criação: somente pelo titular autenticado, id coincidente e saldo inicial estritamente zerado
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.id == accountId &&
        request.resource.data.projectedBalanceCents == 0 &&
        request.resource.data.isArchived == false;
      // Atualização: titularidade mantida, campos estruturais e saldo projetado imutáveis pelo cliente
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId && // userId é imutável
        request.resource.data.id == resource.data.id && // id é imutável
        request.resource.data.createdAt == resource.data.createdAt && // createdAt é imutável
        request.resource.data.projectedBalanceCents == resource.data.projectedBalanceCents; // saldo alterado apenas pelo backend confiável
      allow delete: if false; // Contas com histórico contábil são arquivadas, nunca deletadas

      // 1.1 Livro Oficial de Movimentações (Append-Only, Escrita exclusiva via Backend Confiável Admin SDK)
      match /movements/{movementId} {
        allow read: if isAccountOwner(accountId);
        allow create: if false; // Escrita direta pelo cliente bloqueada; processada via Cloud Functions
        allow update: if false; // Movimentos são estritamente imutáveis
        allow delete: if false; // Estornos criam novos movimentos compensatórios via Cloud Functions
      }

      // 1.2 Metadados Privados e Comprovantes
      match /private_payment_metadata/{paymentId} {
        allow read, write: if isAccountOwner(accountId);
      }

      // 1.3 Faturas de Cartão, Compras, Pagamentos e Carry-Overs (Escrita autoritativa no servidor)
      match /invoices/{invoiceMonth} {
        allow read: if isAccountOwner(accountId);
        allow write: if false;

        match /charges/{chargeId} {
          allow read: if isAccountOwner(accountId);
          allow write: if false;
        }

        match /payments/{paymentId} {
          allow read: if isAccountOwner(accountId);
          allow write: if false;
        }

        match /carry_overs/{carryId} {
          allow read: if isAccountOwner(accountId);
          allow write: if false;
        }
      }
    }

    // 2. Transações, Categorias, Orçamentos, Transferências e Reembolsos Pessoais do Usuário
    match /users/{userId}/personal_transactions/{txId} {
      allow read: if isOwner(userId);
      allow write: if false; // Operações contábeis processadas exclusivamente via Cloud Functions

      match /payments/{paymentId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /payment_reversals/{reversalId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    match /users/{userId}/categories/{categoryId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) &&
        request.resource.data.userId == request.auth.uid;
    }

    match /users/{userId}/budgets/{budgetId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.plannedAmountCents is int &&
        request.resource.data.plannedAmountCents > 0;
    }

    match /users/{userId}/internal_transfers/{transferId} {
      allow read: if isOwner(userId);
      allow write: if false; // Executado atomicamente via Cloud Functions
    }

    match /users/{userId}/personal_refunds/{refundId} {
      allow read: if isOwner(userId);
      allow write: if false; // Executado atomicamente via Cloud Functions

      match /receipts/{receiptId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // Cobertura explícita para coleções equivalentes top-level (isolamento estrito por titular)
    match /personal_incomes/{incomeId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
      match /receipts/{receiptId} {
        allow read: if isAuthenticated() &&
          get(/databases/$(database)/documents/personal_incomes/$(incomeId)).data.userId == request.auth.uid;
        allow write: if false;
      }
    }

    match /personal_expenses/{expenseId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
      match /payments/{paymentId} {
        allow read: if isAuthenticated() &&
          get(/databases/$(database)/documents/personal_expenses/$(expenseId)).data.userId == request.auth.uid;
        allow write: if false;
      }
    }

    match /credit_card_statements/{statementId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
      match /charges/{chargeId} {
        allow read: if isAuthenticated() &&
          get(/databases/$(database)/documents/credit_card_statements/$(statementId)).data.userId == request.auth.uid;
        allow write: if false;
      }
      match /payments/{paymentId} {
        allow read: if isAuthenticated() &&
          get(/databases/$(database)/documents/credit_card_statements/$(statementId)).data.userId == request.auth.uid;
        allow write: if false;
      }
    }

    match /personal_refunds/{refundId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /users/{userId}/notifications/{notificationId} {
      // Leitura restrita exclusivamente ao destinatário titular
      allow read: if isOwner(userId);
      // Criação direta pelo cliente é bloqueada para impedir falsificação e spoofing de avisos por terceiros;
      // Notificações confiáveis do sistema devem ser despachadas por backend confiável (Admin SDK / Cloud Functions).
      allow create: if false;
      // Atualização permitida ao destinatário exclusivamente para alternar a flag 'read'
      allow update: if isOwner(userId) && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
        request.resource.data.read is bool;
      // Exclusão direta desativada para preservar rastreabilidade histórica de avisos recebidos
      allow delete: if false;
    }

    match /users/{userId}/adhoc_obligations/{obligationId} {
      allow read: if isAuthenticated() && 
        (request.auth.uid == userId || request.auth.uid == resource.data.creditorUid);
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.creditorUid;
      allow update: if isAuthenticated() && (
        (request.auth.uid == userId && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['obligationStatus', 'paidAmountCents', 'guestRejectionReason'])) ||
        (request.auth.uid == resource.data.creditorUid && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['obligationStatus', 'paidAmountCents', 'remainingBalanceCents']))
      );
      allow delete: if false;
    }

    // 3. Rateios Avulsos (Despesas fora de espaço)
    match /adhoc_expenses/{expenseId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.ownerUid || 
        request.auth.uid in resource.data.registeredDebtorUids
      );
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.ownerUid;
      allow update: if isAuthenticated() && request.auth.uid == resource.data.ownerUid;
      allow delete: if false;

      // 3.1 Devedores Externos sem Conta (Exclusivo para rateio avulso)
      match /external_debtors/{debtorId} {
        allow read, write: if isAuthenticated() && 
          get(/databases/$(database)/documents/adhoc_expenses/$(expenseId)).data.ownerUid == request.auth.uid;

        match /receipt_events/{eventId} {
          allow read, write: if isAuthenticated() && 
            get(/databases/$(database)/documents/adhoc_expenses/$(expenseId)).data.ownerUid == request.auth.uid;
        }
      }

      // 3.2 Reembolsos de Usuários Cadastrados
      match /reimbursements/{reimbursementId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/adhoc_expenses/$(expenseId)).data.ownerUid == request.auth.uid ||
          resource.data.debtorUid == request.auth.uid
        );
        allow create: if isAuthenticated() && request.resource.data.debtorUid == request.auth.uid;
        allow update: if isAuthenticated() && (
          // O credor valida a confirmação ou rejeição do reembolso
          request.auth.uid == get(/databases/$(database)/documents/adhoc_expenses/$(expenseId)).data.ownerUid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'destinationAccountId', 'financialMovementId', 'confirmedAt', 'rejectionReason'])
        );
      }
    }

    // 3.3 Tokens de Convite para Rateios Avulsos
    match /adhoc_invites/{tokenId} {
      allow read: if true; // Aberto para permitir validação antes da autenticação
      allow create: if isAuthenticated() && request.resource.data.creatorUid == request.auth.uid;
      allow update: if isAuthenticated() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tokenStatus', 'acceptedByUid', 'acceptedAt']);
    }

    // 3.4 Convites Seguros para Espaços Compartilhados (Token SHA-256)
    match /space_invites/{tokenId} {
      // Leitura individual (get) aberta para validação do convite pelo tokenHash exato;
      // Listagem (list) restrita exclusivamente a participantes ativos do espaço do convite (bloqueia listagem global e acesso de ex-participantes).
      allow get: if true;
      allow list: if isAuthenticated() && isSpaceMember(resource.data.spaceId);
      allow create: if isAuthenticated() && 
        isSpaceMember(request.resource.data.spaceId) && 
        isSpaceActive(request.resource.data.spaceId);
      allow update: if isAuthenticated() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'tokenStatus', 'acceptedByUid', 'acceptedByName', 'acceptedAt',
          'rejectedByUid', 'rejectedAt', 'revokedByUid', 'revokedAt'
        ]);
      allow delete: if false; // Convites não são deletados para manter rastreabilidade
    }

    // 4. Espaços Compartilhados e Governança
    match /spaces/{spaceId} {
      // Leitura do documento operacional do espaço (que expõe memberUids atuais e monthlyBudgetCents)
      // restrita EXCLUSIVAMENTE a participantes ativos (ex-participantes usam /historical_views/{memberUid}).
      allow read: if isAuthenticated() && request.auth.uid in resource.data.memberUids;
      allow create: if isAuthenticated() && 
        request.resource.data.creatorUid == request.auth.uid &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.memberUids == [request.auth.uid];
      // Atualização estritamente reservada a participantes operacionais ativos (memberUids)
      allow update: if isSpaceMember(spaceId) && (
        // Somente o criador pode arquivar ou iniciar solicitação de dissolução
        (request.auth.uid == resource.data.creatorUid && 
         request.resource.data.diff(resource.data).affectedKeys().hasAny(['spaceStatus', 'archivedAt', 'archivedByUid'])) ||
        // Configurações gerais permitidas apenas se o espaço estiver ativo
        (isSpaceActive(spaceId) && request.auth.uid in resource.data.memberUids &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['creatorUid', 'ownerId', 'spaceStatus']))
      );
      allow delete: if false;

      // 4.0 Projeção de Consulta Histórica para Ex-Participantes (sem dados operacionais privados dos demais)
      match /historical_views/{memberUid} {
        allow read: if isOwner(memberUid) && isSpaceHistoricalMember(spaceId);
        // Criação/atualização apenas pelo backend confiável (Admin SDK) ou durante saída/remoção autorizada em espaço ativo
        allow write: if isSpaceActive(spaceId) && isSpaceMember(spaceId) && (
          request.auth.uid == memberUid ||
          request.auth.uid == get(/databases/$(database)/documents/spaces/$(spaceId)).data.ownerId ||
          request.auth.uid == get(/databases/$(database)/documents/spaces/$(spaceId)).data.creatorUid
        );
      }

      // 4.1 Membros do Espaço
      match /members/{memberUid} {
        // Participantes ativos leem a lista de membros do espaço.
        // Ex-participantes históricos leem EXCLUSIVAMENTE o seu próprio registro cadastral (preserva privacidade dos demais membros).
        allow read: if isSpaceMember(spaceId) || (
          isOwner(memberUid) && isSpaceHistoricalMember(spaceId)
        );
        // Modificação cadastral permitida apenas por participantes ativos em espaço ativo
        allow write: if isSpaceActive(spaceId) && isSpaceMember(spaceId) && (
          request.auth.uid == get(/databases/$(database)/documents/spaces/$(spaceId)).data.ownerId ||
          request.auth.uid == memberUid
        );
      }

      // 4.2 Trilha de Auditoria e Eventos de Governança
      match /audit/{eventId} {
        // Leitura:
        // - Participantes ativos consultam a trilha de eventos do espaço.
        // - Ex-participantes históricos consultam SOMENTE eventos nos quais foram os atores ou alvos diretos.
        allow read: if isSpaceMember(spaceId) || (
          isSpaceHistoricalMember(spaceId) && (
            resource.data.performedByUid == request.auth.uid ||
            resource.data.targetUid == request.auth.uid
          )
        );
        // CRÍTICO (Anti-Spoofing): Bloqueio estrito de escrita direta pelo cliente para todos os eventos de governança.
        // Nenhuma gravação client-side arbitrária é permitida; eventos oficiais são criados pelo backend confiável.
        allow create: if false;
        allow update, delete: if false; // Eventos de auditoria são estritamente imutáveis
      }

      // 4.3 Solicitação de Dissolução e Destinação Individual
      match /dissolution/{docId} {
        // Leitura restrita exclusivamente a participantes ativos (impede vazamento de decisões privadas para ex-membros)
        allow read: if isSpaceMember(spaceId);
        allow create: if isSpaceCreator(spaceId) && 
          request.resource.data.initiatedByUid == request.auth.uid;
        allow update: if isSpaceMember(spaceId) && (
          // Cancelamento voluntário pelo criador (o cancelamento por timeout é exclusivo do backend server-side)
          (isSpaceCreator(spaceId) &&
           request.resource.data.requestStatus == 'cancelled_by_creator' &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['requestStatus', 'cancelledAt', 'cancellationReason'])) ||
          // Resposta do autor para a sua própria destinação
          (request.auth.uid in get(/databases/$(database)/documents/spaces/$(spaceId)).data.memberUids &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authorDestinations', 'requestStatus']))
        );
        allow delete: if false;
      }

      // 4.4 Despesas Compartilhadas (Travadas se o espaço estiver arquivado)
      match /shared_expenses/{expenseId} {
        // Leitura: Participante ativo OU ex-participante histórico consultando despesa na qual foi autor, responsável ou participante
        allow read: if isSpaceMember(spaceId) || (
          isSpaceHistoricalMember(spaceId) && (
            resource.data.createdByUid == request.auth.uid ||
            resource.data.responsibleUid == request.auth.uid ||
            ('participantUids' in resource.data && request.auth.uid in resource.data.participantUids)
          )
        );
        allow create: if isSpaceMember(spaceId) && isSpaceActive(spaceId) &&
          request.resource.data.createdByUid == request.auth.uid;
        allow update: if isSpaceMember(spaceId) && isSpaceActive(spaceId) && (
          // Validação pelo responsável da despesa (credor primário)
          (request.auth.uid == resource.data.responsibleUid &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['validationStatus', 'validatedByUid', 'validatedAt', 'rejectionReason', 'commitmentStatus', 'paymentExecutionStatus'])) ||
          // Edição pelo autor antes de ser aprovada
          (request.auth.uid == resource.data.createdByUid && 
            resource.data.validationStatus in ['pending_validation', 'rejected'] &&
            request.resource.data.createdByUid == resource.data.createdByUid)
        );
        allow delete: if false;

        match /liabilities/{memberUid} {
          // Ex-participante lê apenas a sua própria obrigação ou se foi responsável pela despesa
          allow read: if isSpaceMember(spaceId) || (
            isSpaceHistoricalMember(spaceId) && (
              isOwner(memberUid) ||
              get(/databases/$(database)/documents/spaces/$(spaceId)/shared_expenses/$(expenseId)).data.responsibleUid == request.auth.uid
            )
          );
          allow write: if isSpaceMember(spaceId) && isSpaceActive(spaceId);
        }

        match /payments/{paymentId} {
          // Ex-participante lê apenas pagamento que ele executou ou de despesa sob sua responsabilidade
          allow read: if isSpaceMember(spaceId) || (
            isSpaceHistoricalMember(spaceId) && (
              resource.data.executedByUid == request.auth.uid ||
              get(/databases/$(database)/documents/spaces/$(spaceId)/shared_expenses/$(expenseId)).data.responsibleUid == request.auth.uid
            )
          );
          allow create: if isSpaceMember(spaceId) && isSpaceActive(spaceId) &&
            request.resource.data.executedByUid == request.auth.uid;
          allow update: if isSpaceMember(spaceId) && isSpaceActive(spaceId) &&
            request.auth.uid == get(/databases/$(database)/documents/spaces/$(spaceId)/shared_expenses/$(expenseId)).data.responsibleUid;
        }

        match /bilateral_debts/{debtId} {
          // Ex-participante lê apenas dívida bilateral em que foi devedor ou credor
          allow read: if isSpaceMember(spaceId) || (
            isSpaceHistoricalMember(spaceId) && (
              resource.data.debtorUid == request.auth.uid ||
              resource.data.creditorUid == request.auth.uid
            )
          );
          allow write: if isSpaceMember(spaceId) && isSpaceActive(spaceId);
        }

        match /refunds/{refundId} {
          // Ex-participante lê apenas reembolso em que foi beneficiário, autor ou responsável pela despesa
          allow read: if isSpaceMember(spaceId) || (
            isSpaceHistoricalMember(spaceId) && (
              resource.data.beneficiaryUid == request.auth.uid ||
              resource.data.recordedByUid == request.auth.uid ||
              get(/databases/$(database)/documents/spaces/$(spaceId)/shared_expenses/$(expenseId)).data.responsibleUid == request.auth.uid
            )
          );
          allow write: if isSpaceMember(spaceId) && isSpaceActive(spaceId) &&
            request.auth.uid == get(/databases/$(database)/documents/spaces/$(spaceId)/shared_expenses/$(expenseId)).data.responsibleUid;
        }

        match /payment_declarations/{declarationId} {
          // Leitura: membros do espaço ou histórico envolvido
          allow read: if isSpaceMember(spaceId) || (
            isSpaceHistoricalMember(spaceId) && (
              resource.data.memberUid == request.auth.uid ||
              resource.data.responsibleUid == request.auth.uid
            )
          );
          // Declaração pode ser criada pelo próprio devedor ativo com validações estritas de negócio
          allow create: if isSpaceMember(spaceId) && isSpaceActive(spaceId) &&
            request.auth.uid == request.resource.data.memberUid &&
            request.resource.data.expenseId == expenseId &&
            request.resource.data.spaceId == spaceId &&
            request.resource.data.amountCents is int &&
            request.resource.data.amountCents > 0 &&
            request.resource.data.status == 'pending_validation';
          allow update, delete: if false; // Imutabilidade estrita: histórico append-only
        }

        match /payment_rejections/{rejectionId} {
          // Leitura: membros do espaço ou histórico envolvido
          allow read: if isSpaceMember(spaceId) || (
            isSpaceHistoricalMember(spaceId) && (
              resource.data.memberUid == request.auth.uid ||
              resource.data.responsibleUid == request.auth.uid
            )
          );
          allow write: if false; // Escrita exclusiva via Cloud Functions autoritativas (Admin SDK)
        }

        match /payment_approvals/{approvalId} {
          // Leitura: membros do espaço ou histórico envolvido
          allow read: if isSpaceMember(spaceId) || (
            isSpaceHistoricalMember(spaceId) && (
              resource.data.memberUid == request.auth.uid ||
              resource.data.responsibleUid == request.auth.uid ||
              resource.data.beneficiaryUid == request.auth.uid
            )
          );
          allow write: if false; // Escrita exclusiva via Cloud Functions autoritativas (Admin SDK)
        }

        match /approval_revocations/{revocationId} {
          // Leitura: membros do espaço ou histórico envolvido
          allow read: if isSpaceMember(spaceId) || (
            isSpaceHistoricalMember(spaceId) && (
              resource.data.memberUid == request.auth.uid ||
              resource.data.responsibleUid == request.auth.uid ||
              resource.data.beneficiaryUid == request.auth.uid
            )
          );
          allow write: if false; // Escrita exclusiva via Cloud Functions autoritativas (Admin SDK)
        }
      }

      // 4.5 Liquidações Bilaterais de Dívidas
      match /settlements/{settlementId} {
        // Leitura: Participante ativo OU ex-participante histórico consultando liquidação onde foi devedor ou credor
        allow read: if isSpaceMember(spaceId) || (
          isSpaceHistoricalMember(spaceId) && (
            resource.data.debtorUid == request.auth.uid ||
            resource.data.creditorUid == request.auth.uid
          )
        );
        allow create: if isSpaceMember(spaceId) && isSpaceActive(spaceId) &&
          request.resource.data.debtorUid == request.auth.uid;
        allow update: if isSpaceMember(spaceId) && isSpaceActive(spaceId) && (
          // Validação exclusiva pelo credor que recebe os fundos
          request.auth.uid == resource.data.creditorUid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'confirmedAt', 'confirmedByUid', 'destinationAccountId', 'financialMovementInflowId'])
        );

        match /allocations/{allocationId} {
          allow read: if isSpaceMember(spaceId) || (
            isSpaceHistoricalMember(spaceId) && (
              get(/databases/$(database)/documents/spaces/$(spaceId)/settlements/$(settlementId)).data.debtorUid == request.auth.uid ||
              get(/databases/$(database)/documents/spaces/$(spaceId)/settlements/$(settlementId)).data.creditorUid == request.auth.uid
            )
          );
          allow write: if isSpaceMember(spaceId) && isSpaceActive(spaceId);
        }

        match /reversions/{reversionId} {
          allow read: if isSpaceMember(spaceId) || (
            isSpaceHistoricalMember(spaceId) && (
              get(/databases/$(database)/documents/spaces/$(spaceId)/settlements/$(settlementId)).data.debtorUid == request.auth.uid ||
              get(/databases/$(database)/documents/spaces/$(spaceId)/settlements/$(settlementId)).data.creditorUid == request.auth.uid
            )
          );
          allow write: if isSpaceMember(spaceId) && isSpaceActive(spaceId) &&
            request.auth.uid == get(/databases/$(database)/documents/spaces/$(spaceId)/settlements/$(settlementId)).data.creditorUid;
        }
      }
    }

    // 5. Transferências sob Custódia (Bilateral e Espaços)
    match /transfers/{transferId} {
      allow read: if isAuthenticated() && (
        resource.data.senderUid == request.auth.uid || 
        resource.data.custodianUid == request.auth.uid ||
        (resource.data.spaceId != null && isSpaceMember(resource.data.spaceId))
      );
      allow create: if isAuthenticated() && request.resource.data.senderUid == request.auth.uid;
      allow update: if isAuthenticated() && (
        // Confirmação de recebimento pelo custodiante
        (request.auth.uid == resource.data.custodianUid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['custodyStatus', 'destinationAccountId', 'availableBalanceCents', 'updatedAt'])) ||
        // Abatimento em despesa pelo custodiante
        (request.auth.uid == resource.data.custodianUid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedAmountCents', 'availableBalanceCents', 'custodyStatus', 'updatedAt'])) ||
        // Confirmação de devolução pelo remetente original
        (request.auth.uid == resource.data.senderUid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['returnedAmountCents', 'availableBalanceCents', 'custodyStatus', 'updatedAt']))
      );

      match /events/{eventId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/transfers/$(transferId)).data.senderUid == request.auth.uid ||
          get(/databases/$(database)/documents/transfers/$(transferId)).data.custodianUid == request.auth.uid
        );
        allow create: if isAuthenticated() && (
          request.auth.uid == get(/databases/$(database)/documents/transfers/$(transferId)).data.senderUid ||
          request.auth.uid == get(/databases/$(database)/documents/transfers/$(transferId)).data.custodianUid
        );
        allow update, delete: if false; // Eventos são estritamente imutáveis
      }
    }

    // 6. Listas de Aquisição e Copropriedade
    match /acquisition_lists/{listId} {
      allow read: if isAuthenticated() && (
        (resource.data.scopeType == 'individual' && resource.data.ownerUid == request.auth.uid) ||
        (resource.data.scopeType == 'shared' && isSpaceMember(resource.data.spaceId))
      );
      allow create: if isAuthenticated() && (
        (request.resource.data.scopeType == 'individual' && request.resource.data.ownerUid == request.auth.uid) ||
        (request.resource.data.scopeType == 'shared' && isSpaceMember(request.resource.data.spaceId) && isSpaceActive(request.resource.data.spaceId))
      );
      allow update: if isAuthenticated() && (
        (resource.data.scopeType == 'individual' && resource.data.ownerUid == request.auth.uid) ||
        (resource.data.scopeType == 'shared' && isSpaceMember(resource.data.spaceId) && isSpaceActive(resource.data.spaceId))
      );
      allow delete: if false;

      match /items/{itemId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();

        match /purchases/{purchaseId} {
          allow read: if isAuthenticated();
          allow create: if isAuthenticated() && request.resource.data.authorUid == request.auth.uid;
          allow update, delete: if false; // Compras efetivadas e percentuais de copropriedade são imutáveis
        }

        match /quotes/{quoteId} {
          allow read, write: if isAuthenticated();
        }

        match /deposits/{depositId} {
          allow read: if isAuthenticated();
          allow create: if isAuthenticated() && request.resource.data.contributorUid == request.auth.uid;
        }

        match /stock_movements/{movementId} {
          allow read: if isAuthenticated();
          allow create: if isAuthenticated() && request.resource.data.authorUid == request.auth.uid;
        }
      }
    }

    // 7. Recorrências e Parcelamentos
    match /recurrence_rules/{ruleId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      match /instances/{competenceMonth} {
        allow read, write: if isAuthenticated();
      }
    }

    match /installment_contracts/{contractId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      match /occurrences/{installmentNumber} {
        allow read, write: if isAuthenticated();
      }
    }

    // 8. Regra Collection Group para Consulta Histórica Restrita de Ex-Participantes
    match /{path=**}/historical_views/{memberUid} {
      allow list: if isAuthenticated() && resource.data.memberUid == request.auth.uid;
    }
  }
}
